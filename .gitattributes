# Исходники и проекты .NET — LF, UTF-8 без BOM (правило проекта, docs/07 1.1).
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.shader    text eol=lf
*.asmdef    text eol=lf
*.meta      text eol=lf

# Единичные файлы Unity (сцены, префабы, настройки) — текст: диффы должны читаться. Unity пишет YAML с LF
# на любой ОС; без eol=lf Git на Windows выдаёт их с CRLF, и каждая сборка Unity оставляла `git status`
# грязным при том же содержимом (0-016).
*.unity     text eol=lf
*.asset     text eol=lf
*.prefab    text eol=lf
*.mat       text eol=lf

# Windows-скрипты и решение — CRLF.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.sln       text eol=crlf

# Двоичное.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.psd       binary
*.tga       binary
*.dll       binary
*.exe       binary
*.a         binary
*.lib       binary
