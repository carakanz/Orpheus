<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ServerHost (docs/07, 1.3 и 1.6; карточка 0-031): цикл сервера — такт, NetServer, сохранения, журнал, часы, метрики —
    библиотекой netstandard2.1. Её берут и программа OrpheusServer (net9.0, тонкая оболочка), и клиент Unity в режиме
    «сервер в потоке» (на консоли дочерних процессов нет). Здесь нет Unity, рефлексии, P/Invoke, Console, Process и
    прямых File.*/Directory.*: файлы мира — только через IPlatformStorage, часы высокого разрешения, лог JSON и память
    процесса — снаружи (ServerHostServices). Правила ORP (детерминизм симуляции) здесь не включены: это не симуляция,
    а цикл вокруг неё — часы и метрики настенные по делу (как в Orpheus.Platform.Pc). Проверка — CoreAssemblyRules
    D07_S1_6_ServerHost_*.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Orpheus.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Гистограмма метрик такта (TickStats.AddTick) — в тестах без настоящих часов (0-030). -->
    <InternalsVisibleTo Include="Orpheus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orpheus.Core\Orpheus.Core.csproj" />
    <ProjectReference Include="..\Orpheus.WorldGen\Orpheus.WorldGen.csproj" />
    <ProjectReference Include="..\Orpheus.Net\Orpheus.Net.csproj" />
    <ProjectReference Include="..\Orpheus.Save\Orpheus.Save.csproj" />
  </ItemGroup>

</Project>
