<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roslyn-анализатор правил повторяемости и тора (docs/07, 3.2 и 11.5), коды ORP0xx.
    Подключается к Core, WorldGen, Net, Save через Directory.Build.targets (OrpheusDeterministicRules).

    Microsoft.CodeAnalysis.CSharp 4.3.1 закреплён намеренно:
    - Unity 6 принимает анализаторы (DLL с меткой RoslynAnalyzer), собранные против Microsoft.CodeAnalysis 4.3;
      компилятор в Unity 6000.6.7f1 — Roslyn 4.10 (Editor/Data/DotNetSdk/sdk/8.0.318/Roslyn), он грузит анализаторы
      версии не выше своей;
    - .NET SDK 9.0.318 — Roslyn 4.14, тоже не ниже 4.3.
    Поднимать версию — только не выше компилятора Unity, после проверки в клиенте.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Сборка анализатора сама не симуляция: правила ORP к ней не применяются. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
