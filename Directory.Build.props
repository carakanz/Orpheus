<Project>
  <!-- Общие настройки всех проектов Orpheus (docs/07, 1.3). -->
  <PropertyGroup>
    <!-- Unity 6: API .NET Standard 2.1, язык C# 9. Без возможностей C# 10+
         (file-scoped namespace, global using, record struct). -->
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Заворот координат тора опирается на арифметику int32 по модулю 2^32. -->
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
